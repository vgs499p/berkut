+// SPDX-License-Identifier: GPL-2.0-or-later
+// Berkut: downloads a guest system from the project's releases into Documents.
+
+import CryptoKit
+import Foundation
+import SwiftUI
+
+/// One entry of the published catalog: an erofs image, zstd-compressed and
+/// split into parts that fit a release asset.
+nonisolated struct SystemImage: Decodable, Identifiable, Hashable, Sendable {
+    struct Part: Decodable, Hashable, Sendable {
+        let file: String
+        let size: Int64
+        let sha256: String
+    }
+
+    let distro: String
+    let desktop: String
+    let file: String
+    let size: Int64
+    let sha256: String
+    let parts: [Part]
+
+    var id: String { file }
+    var downloadSize: Int64 { parts.reduce(0) { $0 + $1.size } }
+
+    var distroName: String {
+        ["arch": "Arch Linux ARM", "fedora": "Fedora", "ubuntu": "Ubuntu"][distro]
+            ?? distro
+    }
+
+    var desktopName: String {
+        [
+            "plasma-mobile": "Plasma Mobile", "phosh": "Phosh",
+            "plasma": "Plasma Desktop", "xfce": "Xfce", "lomiri": "Lomiri",
+        ][desktop] ?? desktop
+    }
+
+    /// Whether every name stays a plain file name the launcher accepts.
+    var isWellFormed: Bool {
+        RootfsImage.validatedFilename(file) != nil && !parts.isEmpty &&
+            parts.allSatisfy {
+                !$0.file.isEmpty && !$0.file.hasPrefix(".") &&
+                    ($0.file as NSString).lastPathComponent == $0.file
+            }
+    }
+}
+
+nonisolated private struct SystemCatalog: Decodable, Sendable {
+    let images: [SystemImage]
+}
+
+/// The account the guest creates at its first boot.
+nonisolated struct GuestAccount: Equatable, Sendable {
+    var username = ""
+    var password = ""
+    var hostname = "berkut"
+
+    var problem: String? {
+        if username.range(
+            of: "^[a-z_][a-z0-9_-]{0,30}$", options: .regularExpression
+        ) == nil || username == "root" {
+            return "Username: lowercase letters, digits, - or _, not root."
+        }
+        if password.isEmpty || password.contains(where: \.isNewline) {
+            return "Enter a password."
+        }
+        if hostname.range(
+            of: "^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$", options: .regularExpression
+        ) == nil {
+            return "Computer name: letters, digits and - only."
+        }
+        return nil
+    }
+
+    var setupFile: Data {
+        Data("USERNAME=\(username)\nPASSWORD=\(password)\nHOSTNAME=\(hostname)\n".utf8)
+    }
+}
+
+nonisolated struct InstallError: LocalizedError {
+    let message: String
+    var errorDescription: String? { message }
+}
+
+/// Streams zstd parts, in order, into one file while hashing the result.
+nonisolated private final class ImageWriter: @unchecked Sendable {
+    private let stream: OpaquePointer
+    private let output: FileHandle
+    private var hash = SHA256()
+    private var pending = 1
+
+    init(url: URL) throws {
+        guard FileManager.default.createFile(atPath: url.path, contents: nil),
+              let stream = ZSTD_createDStream() else {
+            throw InstallError(message: "Cannot create the system file.")
+        }
+        self.stream = stream
+        output = try FileHandle(forWritingTo: url)
+        ZSTD_initDStream(stream)
+    }
+
+    deinit {
+        ZSTD_freeDStream(stream)
+        try? output.close()
+    }
+
+    /// Verifies one downloaded part and appends what it decompresses to.
+    func consume(part url: URL, expecting digest: String) throws {
+        guard try Self.digest(of: url) == digest else {
+            throw InstallError(message: "A download was damaged. Try again.")
+        }
+        let input = try FileHandle(forReadingFrom: url)
+        defer { try? input.close() }
+        var buffer = [UInt8](repeating: 0, count: ZSTD_DStreamOutSize())
+        while true {
+            let more = try autoreleasepool { () -> Bool in
+                guard let chunk = try input.read(upToCount: 1 << 20),
+                      !chunk.isEmpty else { return false }
+                try chunk.withUnsafeBytes { raw in
+                    var source = ZSTD_inBuffer(
+                        src: raw.baseAddress, size: raw.count, pos: 0
+                    )
+                    var full = false
+                    while source.pos < source.size || full {
+                        let produced = try buffer.withUnsafeMutableBytes { out -> Data in
+                            var sink = ZSTD_outBuffer(
+                                dst: out.baseAddress, size: out.count, pos: 0
+                            )
+                            pending = ZSTD_decompressStream(stream, &sink, &source)
+                            guard ZSTD_isError(pending) == 0 else {
+                                throw InstallError(message: "The system file is corrupt.")
+                            }
+                            full = sink.pos == sink.size
+                            return Data(bytes: out.baseAddress!, count: sink.pos)
+                        }
+                        hash.update(data: produced)
+                        try output.write(contentsOf: produced)
+                    }
+                }
+                return true
+            }
+            if !more { break }
+        }
+    }
+
+    func finish(expecting digest: String) throws {
+        try output.synchronize()
+        let actual = hash.finalize().map { String(format: "%02x", $0) }.joined()
+        guard pending == 0, actual == digest else {
+            throw InstallError(message: "The system did not verify. Try again.")
+        }
+    }
+
+    private static func digest(of url: URL) throws -> String {
+        let input = try FileHandle(forReadingFrom: url)
+        defer { try? input.close() }
+        var hash = SHA256()
+        while try autoreleasepool(invoking: { () -> Bool in
+            guard let chunk = try input.read(upToCount: 1 << 20),
+                  !chunk.isEmpty else { return false }
+            hash.update(data: chunk)
+            return true
+        }) {}
+        return hash.finalize().map { String(format: "%02x", $0) }.joined()
+    }
+}
+
+@MainActor
+final class SystemInstaller: ObservableObject {
+    static let shared = SystemInstaller()
+
+    private static let base = URL(
+        string: "https://github.com/vgs499p/berkut/releases/download/images-1/"
+    )!
+
+    enum Phase: Equatable {
+        case idle
+        case working(String, Double)
+        case installed(String)
+        case failed(String)
+    }
+
+    @Published private(set) var images: [SystemImage] = []
+    @Published private(set) var catalogProblem: String?
+    @Published private(set) var phase = Phase.idle
+
+    private var task: Task<Void, Never>?
+
+    var isWorking: Bool {
+        if case .working = phase { return true }
+        return false
+    }
+
+    func loadCatalog() async {
+        catalogProblem = nil
+        do {
+            var request = URLRequest(url: Self.base.appendingPathComponent("catalog.json"))
+            request.cachePolicy = .reloadIgnoringLocalCacheData
+            let (data, response) = try await URLSession.shared.data(for: request)
+            guard (response as? HTTPURLResponse)?.statusCode == 200 else {
+                throw InstallError(message: "No systems are published yet.")
+            }
+            images = try JSONDecoder().decode(SystemCatalog.self, from: data)
+                .images.filter(\.isWellFormed)
+        } catch {
+            catalogProblem = error.localizedDescription
+        }
+    }
+
+    func install(_ image: SystemImage, account: GuestAccount) {
+        guard !isWorking else { return }
+        guard EmulatorLauncher.shared.runningGuestName != image.file else {
+            phase = .failed(
+                "This system is running. Pick another one in Settings, " +
+                    "reopen Berkut, then reinstall it."
+            )
+            return
+        }
+        phase = .working("Preparing", 0)
+        UIApplication.shared.isIdleTimerDisabled = true
+        task = Task {
+            do {
+                try await download(image, account: account)
+                phase = .installed(image.file)
+            } catch is CancellationError {
+                phase = .idle
+            } catch {
+                phase = Task.isCancelled ? .idle : .failed(error.localizedDescription)
+            }
+            if EmulatorLauncher.shared.runningGuestName == nil {
+                UIApplication.shared.isIdleTimerDisabled = false
+            }
+        }
+    }
+
+    func cancel() {
+        task?.cancel()
+    }
+
+    private func download(_ image: SystemImage, account: GuestAccount) async throws {
+        let manager = FileManager.default
+        let documents = RootfsImage.documentsDirectory
+        let destination = documents.appendingPathComponent(image.file)
+        // Hidden, so the image picker never offers a half-written system.
+        let partial = documents.appendingPathComponent(".\(image.file).partial")
+        defer { try? manager.removeItem(at: partial) }
+
+        let largest = image.parts.map(\.size).max() ?? 0
+        let free = try documents.resourceValues(
+            forKeys: [.volumeAvailableCapacityForImportantUsageKey]
+        ).volumeAvailableCapacityForImportantUsage ?? 0
+        let needed = image.size + largest + (1 << 30)
+        guard free >= needed else {
+            let format = ByteCountFormatter()
+            throw InstallError(
+                message: "Not enough space: \(format.string(fromByteCount: needed)) " +
+                    "needed, \(format.string(fromByteCount: free)) free."
+            )
+        }
+
+        let writer = try ImageWriter(url: partial)
+        var done: Int64 = 0
+        for (index, part) in image.parts.enumerated() {
+            let label = "Downloading \(index + 1) of \(image.parts.count)"
+            let file = try await fetch(
+                Self.base.appendingPathComponent(part.file)
+            ) { fraction in
+                self.phase = .working(
+                    label,
+                    (Double(done) + fraction * Double(part.size)) /
+                        Double(image.downloadSize)
+                )
+            }
+            defer { try? manager.removeItem(at: file) }
+            try Task.checkCancellation()
+            phase = .working("Unpacking", Double(done + part.size) / Double(image.downloadSize))
+            try await Task.detached(priority: .userInitiated) {
+                try writer.consume(part: file, expecting: part.sha256)
+            }.value
+            try Task.checkCancellation()
+            done += part.size
+        }
+        try writer.finish(expecting: image.sha256)
+
+        // A reinstalled system starts clean: its old writable disk would lay
+        // the previous system's files over the new one.
+        let overlay = try OverlayDisk.location(for: image.file)
+        try? manager.removeItem(at: overlay)
+        try account.setupFile.write(
+            to: OverlayDisk.setupFile(beside: overlay),
+            options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication]
+        )
+        try? manager.removeItem(at: destination)
+        try manager.moveItem(at: partial, to: destination)
+        var stored = destination
+        var values = URLResourceValues()
+        values.isExcludedFromBackup = true
+        try? stored.setResourceValues(values)
+
+        var configuration = EmulatorConfiguration.load()
+        configuration.rootfsFilename = image.file
+        configuration.save()
+    }
+
+    /// Downloads one file to a temporary location, reporting its fraction.
+    private func fetch(
+        _ url: URL, progress: @escaping (Double) -> Void
+    ) async throws -> URL {
+        let kept = FileManager.default.temporaryDirectory
+            .appendingPathComponent("berkut-part-\(UUID().uuidString)")
+        let box = DownloadBox()
+        let reporter = Task {
+            while !Task.isCancelled {
+                if let fraction = box.task?.progress.fractionCompleted {
+                    progress(fraction)
+                }
+                try? await Task.sleep(for: .milliseconds(300))
+            }
+        }
+        defer { reporter.cancel() }
+        return try await withTaskCancellationHandler {
+            try await withCheckedThrowingContinuation { continuation in
+                let task = URLSession.shared.downloadTask(with: url) {
+                    file, response, error in
+                    do {
+                        if let error { throw error }
+                        guard let file,
+                              (response as? HTTPURLResponse)?.statusCode == 200 else {
+                            throw InstallError(message: "The download failed.")
+                        }
+                        // The system deletes `file` when this handler returns.
+                        try FileManager.default.moveItem(at: file, to: kept)
+                        continuation.resume(returning: kept)
+                    } catch {
+                        continuation.resume(throwing: error)
+                    }
+                }
+                box.task = task
+                task.resume()
+            }
+        } onCancel: {
+            box.task?.cancel()
+        }
+    }
+}
+
+nonisolated private final class DownloadBox: @unchecked Sendable {
+    private let lock = NSLock()
+    private var stored: URLSessionDownloadTask?
+    var task: URLSessionDownloadTask? {
+        get { lock.withLock { stored } }
+        set { lock.withLock { stored = newValue } }
+    }
+}
+
+/// Pick a distribution and desktop, name the account, install.
+struct SystemInstallerView: View {
+    @ObservedObject private var installer = SystemInstaller.shared
+    @Environment(\.dismiss) private var dismiss
+    @State private var distro = ""
+    @State private var desktop = ""
+    @State private var account = GuestAccount()
+
+    private var distros: [String] {
+        installer.images.map(\.distro).reduce(into: []) {
+            if !$0.contains($1) { $0.append($1) }
+        }
+    }
+
+    private var desktops: [SystemImage] {
+        installer.images.filter { $0.distro == distro }
+    }
+
+    private var selected: SystemImage? {
+        desktops.first { $0.desktop == desktop }
+    }
+
+    var body: some View {
+        NavigationStack {
+            Form {
+                if let problem = installer.catalogProblem {
+                    Section {
+                        Text(problem)
+                        Button("Try again") {
+                            Task { await installer.loadCatalog() }
+                        }
+                    }
+                } else if installer.images.isEmpty {
+                    Section { ProgressView("Loading systems") }
+                } else {
+                    Section("System") {
+                        Picker("Distribution", selection: $distro) {
+                            ForEach(distros, id: \.self) { name in
+                                Text(installer.images.first { $0.distro == name }?
+                                    .distroName ?? name).tag(name)
+                            }
+                        }
+                        Picker("Desktop", selection: $desktop) {
+                            ForEach(desktops) {
+                                Text($0.desktopName).tag($0.desktop)
+                            }
+                        }
+                        if let selected {
+                            LabeledContent(
+                                "Download",
+                                value: ByteCountFormatter.string(
+                                    fromByteCount: selected.downloadSize,
+                                    countStyle: .file
+                                )
+                            )
+                        }
+                    }
+                    Section {
+                        TextField("Username", text: $account.username)
+                            .textInputAutocapitalization(.never)
+                            .autocorrectionDisabled()
+                        SecureField("Password", text: $account.password)
+                            .textInputAutocapitalization(.never)
+                            .autocorrectionDisabled()
+                        TextField("Computer name", text: $account.hostname)
+                            .textInputAutocapitalization(.never)
+                            .autocorrectionDisabled()
+                    } header: {
+                        Text("Your account")
+                    } footer: {
+                        Text(account.problem ?? "Created at the first start. It can use sudo. The root password is root.")
+                    }
+                    Section {
+                        status
+                    } footer: {
+                        Text("Keep Berkut open while it downloads. Reinstalling a system erases its files.")
+                    }
+                }
+            }
+            .navigationTitle("Install a system")
+            .navigationBarTitleDisplayMode(.inline)
+            .toolbar {
+                ToolbarItem(placement: .cancellationAction) {
+                    Button("Close") { dismiss() }
+                }
+            }
+        }
+        .interactiveDismissDisabled(installer.isWorking)
+        .task {
+            if installer.images.isEmpty { await installer.loadCatalog() }
+        }
+        .onChange(of: installer.images, initial: true) {
+            if distro.isEmpty { distro = distros.first ?? "" }
+        }
+        .onChange(of: distro, initial: true) {
+            if selected == nil { desktop = desktops.first?.desktop ?? "" }
+        }
+    }
+
+    @ViewBuilder
+    private var status: some View {
+        switch installer.phase {
+        case let .working(label, fraction):
+            ProgressView(value: min(max(fraction, 0), 1)) { Text(label) }
+            Button("Cancel download", role: .destructive) { installer.cancel() }
+        case .installed:
+            Label("Installed. Close Berkut (swipe it away) and open it again.",
+                  systemImage: "checkmark.circle")
+            installButton
+        case let .failed(message):
+            Label(message, systemImage: "exclamationmark.triangle")
+            installButton
+        case .idle:
+            installButton
+        }
+    }
+
+    private var installButton: some View {
+        Button("Install") {
+            if let selected { installer.install(selected, account: account) }
+        }
+        .disabled(selected == nil || account.problem != nil)
+    }
+}
