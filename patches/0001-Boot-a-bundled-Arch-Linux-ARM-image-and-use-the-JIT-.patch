From 7f9886f1eb1e90d91bd9e076e52cd855ca971075 Mon Sep 17 00:00:00 2001
From: s1oplus <victorgarcez@proton.me>
Date: Thu, 19 Nov 2026 18:00:59 -0300
Subject: [PATCH 1/6] Boot a bundled Arch Linux ARM image and use the JIT under
 StikDebug

Clone the archlinuxarm-kde.erofs image the application bundle carries into
Documents at launch, replacing an earlier copy of a different size, and boot
it by default. When a debugger that serves the JIT's memory request is
attached, prepare the JIT and boot on it; otherwise run on the interpreter.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Kernarium/Kernarium/ContentView.swift         | 13 +++++++++-
 .../Kernarium/EmulatorConfiguration.swift     | 24 ++++++++++++++++++-
 Kernarium/Kernarium/KernariumApp.swift        |  1 +
 3 files changed, 36 insertions(+), 2 deletions(-)

diff --git a/Kernarium/Kernarium/ContentView.swift b/Kernarium/Kernarium/ContentView.swift
index 8ee4cfa..0cbb303 100644
--- a/Kernarium/Kernarium/ContentView.swift
+++ b/Kernarium/Kernarium/ContentView.swift
@@ -835,8 +835,19 @@ private func runGuest(
     autoResizeGuest: Bool,
     gpuBudget: GPUBudgetParameters
 ) -> Int32 {
-    boot.withCPaths { paths in
+    // When the application was opened from a debugger that serves the JIT's
+    // memory request (StikDebug), prepare it and boot on the JIT; otherwise
+    // the guest runs on the interpreter. This runs on the run's own thread,
+    // which may block for the seconds the debugger takes.
+    var useJit = false
+    if kernarium_runtime_loader_debugger_attached() != 0 {
+        let answer = kernarium_runtime_loader_prepare_jit(1, guestMemoryMiB, vCPUCount)
+        useJit = answer == Int32(KERNARIUM_RUNTIME_JIT_READY)
+        print("Kernarium: JIT preparation answered \(answer); using JIT: \(useJit)")
+    }
+    return boot.withCPaths { paths in
         var request = kernarium_runtime_boot()
+        request.use_jit = useJit ? 1 : 0
         request.struct_size = UInt32(MemoryLayout<kernarium_runtime_boot>.size)
         request.width = width
         request.height = height
diff --git a/Kernarium/Kernarium/EmulatorConfiguration.swift b/Kernarium/Kernarium/EmulatorConfiguration.swift
index fb5fc1a..30c0740 100644
--- a/Kernarium/Kernarium/EmulatorConfiguration.swift
+++ b/Kernarium/Kernarium/EmulatorConfiguration.swift
@@ -401,9 +401,31 @@ enum RootfsImage {
     /// The accepted KDE desktop image (tools/rootfs/desktop/images.json),
     /// which carries its own session setup. It applies only while the
     /// settings store no name: a stored name, `rootfs.erofs` included, is kept.
-    static let defaultFilename = "kde-20260929-r2.erofs"
+    static let defaultFilename = "archlinuxarm-kde.erofs"
     static let environmentKey = "KERNARIUM_ROOTFS"
 
+    /// Clones the Arch Linux ARM image the application bundle carries into
+    /// Documents, where the launcher and the settings look for images. On
+    /// APFS the copy is a clone, so it costs no extra space until written.
+    static func installBundledImageIfNeeded(fileManager: FileManager = .default) {
+        guard let source = Bundle.main.url(
+            forResource: "archlinuxarm-kde", withExtension: "erofs"
+        ) else { return }
+        let destination = documentsDirectory.appendingPathComponent(defaultFilename)
+        // A copy from an earlier version of the application is replaced, so
+        // an updated image reaches the guest; the guest never writes to the
+        // image, so nothing of the user's is lost.
+        if fileManager.fileExists(atPath: destination.path) {
+            func size(_ url: URL) -> Int64? {
+                (try? fileManager.attributesOfItem(atPath: url.path)[.size] as? NSNumber)?
+                    .int64Value
+            }
+            guard size(source) != size(destination) else { return }
+            try? fileManager.removeItem(at: destination)
+        }
+        try? fileManager.copyItem(at: source, to: destination)
+    }
+
     nonisolated static var documentsDirectory: URL {
         FileManager.default.urls(
             for: .documentDirectory,
diff --git a/Kernarium/Kernarium/KernariumApp.swift b/Kernarium/Kernarium/KernariumApp.swift
index dde40af..7e0281a 100644
--- a/Kernarium/Kernarium/KernariumApp.swift
+++ b/Kernarium/Kernarium/KernariumApp.swift
@@ -5,6 +5,7 @@ import SwiftUI
 @main
 struct KernariumApp: App {
     init() {
+        RootfsImage.installBundledImageIfNeeded()
         // Before any view: the display and the terminal compile Metal
         // pipelines as they are created, and that reads the shader cache.
         MetalShaderCache.removeIfBloatedBeforeFirstUse()
