From a223623feea22d8d8e848131525ce0cb37b25c6d Mon Sep 17 00:00:00 2001
From: s1oplus <victorgarcez@proton.me>
Date: Thu, 19 Nov 2026 18:01:41 -0300
Subject: [PATCH 3/6] Brand the application as Berkut

Display name, application bundle identifier, microphone prompt and the
light, dark and tinted 1024-point icons, applied by
branding/apply-branding.sh in the Berkut repository.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Kernarium/Info.plist                          |  12 ++-
 Kernarium/Kernarium.xcodeproj/project.pbxproj |   4 +-
 .../AppIcon.appiconset/AppIcon-dark.png       | Bin 0 -> 68523 bytes
 .../AppIcon.appiconset/AppIcon-tinted.png     | Bin 0 -> 30322 bytes
 .../AppIcon.appiconset/AppIcon.png            | Bin 0 -> 68379 bytes
 .../AppIcon.appiconset/Contents.json          | 101 +++++++++---------
 6 files changed, 61 insertions(+), 56 deletions(-)
 create mode 100644 Kernarium/Kernarium/Assets.xcassets/AppIcon.appiconset/AppIcon-dark.png
 create mode 100644 Kernarium/Kernarium/Assets.xcassets/AppIcon.appiconset/AppIcon-tinted.png
 create mode 100644 Kernarium/Kernarium/Assets.xcassets/AppIcon.appiconset/AppIcon.png

diff --git a/Kernarium/Info.plist b/Kernarium/Info.plist
index 4dca895..c9f8e46 100644
--- a/Kernarium/Info.plist
+++ b/Kernarium/Info.plist
@@ -6,17 +6,19 @@
 	<array>
 		<string>com.imxieyi.Kernarium.guest.*</string>
 	</array>
+	<key>CFBundleDisplayName</key>
+	<string>Berkut</string>
 	<key>NSMicrophoneUsageDescription</key>
-	<string>Kernarium records from the microphone only when you turn on Microphone in Emulator settings, so that programs in the guest can use it.</string>
-	<key>UIBackgroundModes</key>
-	<array>
-		<string>audio</string>
-	</array>
+	<string>Berkut records from the microphone only when you turn on Microphone in Emulator settings, so that programs in the guest can use it.</string>
 	<key>UIApplicationSceneManifest</key>
 	<dict>
 		<key>UIApplicationSupportsMultipleScenes</key>
 		<false/>
 	</dict>
+	<key>UIBackgroundModes</key>
+	<array>
+		<string>audio</string>
+	</array>
 	<key>UIFileSharingEnabled</key>
 	<true/>
 </dict>
diff --git a/Kernarium/Kernarium.xcodeproj/project.pbxproj b/Kernarium/Kernarium.xcodeproj/project.pbxproj
index e7648c5..cddf095 100644
--- a/Kernarium/Kernarium.xcodeproj/project.pbxproj
+++ b/Kernarium/Kernarium.xcodeproj/project.pbxproj
@@ -621,7 +621,7 @@
 				IPHONEOS_DEPLOYMENT_TARGET = 27.0;
 				LD_RUNPATH_SEARCH_PATHS = "@executable_path/Frameworks";
 				MARKETING_VERSION = 1.0;
-				PRODUCT_BUNDLE_IDENTIFIER = com.imxieyi.Kernarium;
+				PRODUCT_BUNDLE_IDENTIFIER = app.berkut.Berkut;
 				PRODUCT_NAME = "$(TARGET_NAME)";
 				SDKROOT = iphoneos;
 				STRING_CATALOG_GENERATE_SYMBOLS = YES;
@@ -669,7 +669,7 @@
 				IPHONEOS_DEPLOYMENT_TARGET = 27.0;
 				LD_RUNPATH_SEARCH_PATHS = "@executable_path/Frameworks";
 				MARKETING_VERSION = 1.0;
-				PRODUCT_BUNDLE_IDENTIFIER = com.imxieyi.Kernarium;
+				PRODUCT_BUNDLE_IDENTIFIER = app.berkut.Berkut;
 				PRODUCT_NAME = "$(TARGET_NAME)";
 				SDKROOT = iphoneos;
 				STRING_CATALOG_GENERATE_SYMBOLS = YES;
