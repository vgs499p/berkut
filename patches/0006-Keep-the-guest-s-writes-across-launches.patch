From ad6693d0d9102e64abca3abf756c35568c4a61ab Mon Sep 17 00:00:00 2001
From: Berkut <berkut@localhost>
Date: Thu, 19 Nov 2026 19:58:05 -0300
Subject: [PATCH 6/6] Keep the guest's writes across launches

The application keeps the overlay disk in Application Support (excluded
from backups) instead of recreating it in the temporary directory, and
grows it when the setting is raised. The runtime passes
UML_BOOT_UPPER_KEEP=1, with which /init checks, repairs and resizes an
existing ext4 layer and formats only a blank or unrepairable one. A guest
asks for a fresh layer by creating /.uml-state/.uml-reset.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Kernarium/Kernarium/ContentView.swift         | 45 ++++++++++------
 Kernarium/KernariumTests/KernariumTests.swift | 15 ++++--
 Kernarium/Runtime/KernariumRuntime.mm         |  3 ++
 tools/rootfs/boot-ramdisk/init                | 53 +++++++++++++++++--
 4 files changed, 92 insertions(+), 24 deletions(-)

diff --git a/Kernarium/Kernarium/ContentView.swift b/Kernarium/Kernarium/ContentView.swift
index 0cbb303..d4a258c 100644
--- a/Kernarium/Kernarium/ContentView.swift
+++ b/Kernarium/Kernarium/ContentView.swift
@@ -696,27 +696,42 @@ enum OverlayDisk {
         return UInt64(sizeGiB) * 1024 * 1024 * 1024
     }
 
-    static func recreate(
-        sizeGiB: Int,
-        in directory: URL = FileManager.default.temporaryDirectory
-    ) throws -> URL {
+    /// Berkut keeps the overlay disk in Application Support, out of iCloud
+    /// backups, so the guest's writes survive a relaunch. A missing disk is
+    /// created sparse at the requested size and a smaller one is grown to it;
+    /// the boot's /init formats a blank disk and keeps (and resizes) an
+    /// existing filesystem. The temporary-directory copy older builds left is
+    /// removed.
+    static func prepare(sizeGiB: Int, in directory: URL? = nil) throws -> URL {
         let manager = FileManager.default
-        let disk = directory.appendingPathComponent(filename)
+        let directory = try directory ?? manager.url(
+            for: .applicationSupportDirectory, in: .userDomainMask,
+            appropriateFor: nil, create: true
+        )
+        try? manager.removeItem(
+            at: manager.temporaryDirectory.appendingPathComponent(filename)
+        )
+        var disk = directory.appendingPathComponent(filename)
         let requestedByteCount = try byteCount(forSizeGiB: sizeGiB)
-        if manager.fileExists(atPath: disk.path) {
-            try manager.removeItem(at: disk)
-        }
-        guard manager.createFile(atPath: disk.path, contents: nil) else {
-            throw CocoaError(.fileWriteUnknown)
+        let created = !manager.fileExists(atPath: disk.path)
+        if created {
+            guard manager.createFile(atPath: disk.path, contents: nil) else {
+                throw CocoaError(.fileWriteUnknown)
+            }
         }
         do {
             let handle = try FileHandle(forWritingTo: disk)
             defer { try? handle.close() }
-            try handle.truncate(atOffset: requestedByteCount)
+            if try handle.seekToEnd() < requestedByteCount {
+                try handle.truncate(atOffset: requestedByteCount)
+            }
         } catch {
-            try? manager.removeItem(at: disk)
+            if created { try? manager.removeItem(at: disk) }
             throw error
         }
+        var values = URLResourceValues()
+        values.isExcludedFromBackup = true
+        try? disk.setResourceValues(values)
         return disk
     }
 }
@@ -1126,8 +1141,8 @@ final class EmulatorLauncher: ObservableObject, SpaceRun {
         return run()
     }
 
-    /// A plain image boots read-only under a disposable overlay disk, which is
-    /// recreated every launch and holds no state worth keeping.
+    /// A plain image boots read-only under the persistent overlay disk, which
+    /// holds everything the guest writes.
     private func prepareImageBoot(rootfs: URL) -> PreparedBoot? {
         if rootfs.pathExtension.lowercased() == "ext4" {
             do {
@@ -1141,7 +1156,7 @@ final class EmulatorLauncher: ObservableObject, SpaceRun {
             }
         }
         do {
-            let overlay = try OverlayDisk.recreate(
+            let overlay = try OverlayDisk.prepare(
                 sizeGiB: configuration.overlaySizeGiB
             )
             return PreparedBoot(rootfs: rootfs, overlay: overlay)
diff --git a/Kernarium/KernariumTests/KernariumTests.swift b/Kernarium/KernariumTests/KernariumTests.swift
index f6982c1..72005ae 100644
--- a/Kernarium/KernariumTests/KernariumTests.swift
+++ b/Kernarium/KernariumTests/KernariumTests.swift
@@ -657,26 +657,31 @@ struct KernariumTests {
 
     @Test
     @MainActor
-    func overlayDiskIsRecreatedAtRequestedSize() throws {
+    func overlayDiskKeepsItsContentsAndGrows() throws {
         let manager = FileManager.default
         let directory = try makeScratchDirectory("overlay-disk")
         defer { try? manager.removeItem(at: directory) }
 
-        let first = try OverlayDisk.recreate(sizeGiB: 3, in: directory)
+        let first = try OverlayDisk.prepare(sizeGiB: 3, in: directory)
         let writer = try FileHandle(forWritingTo: first)
         try writer.write(contentsOf: Data([0xa5]))
         try writer.close()
 
-        let second = try OverlayDisk.recreate(sizeGiB: 3, in: directory)
+        let second = try OverlayDisk.prepare(sizeGiB: 4, in: directory)
         let attributes = try manager.attributesOfItem(atPath: second.path)
         let size = attributes[.size] as? NSNumber
         #expect(first == second)
-        #expect(size?.uint64Value == 3 * 1024 * 1024 * 1024)
+        #expect(size?.uint64Value == 4 * 1024 * 1024 * 1024)
 
         let reader = try FileHandle(forReadingFrom: second)
         let prefix = try reader.read(upToCount: 1)
         try reader.close()
-        #expect(prefix == Data([0]))
+        #expect(prefix == Data([0xa5]))
+
+        // A smaller setting never shrinks the disk.
+        let third = try OverlayDisk.prepare(sizeGiB: 2, in: directory)
+        let after = try manager.attributesOfItem(atPath: third.path)[.size] as? NSNumber
+        #expect(after?.uint64Value == 4 * 1024 * 1024 * 1024)
     }
 
     @Test
diff --git a/Kernarium/Runtime/KernariumRuntime.mm b/Kernarium/Runtime/KernariumRuntime.mm
index 44d9f05..99911c4 100644
--- a/Kernarium/Runtime/KernariumRuntime.mm
+++ b/Kernarium/Runtime/KernariumRuntime.mm
@@ -1376,6 +1376,9 @@ std::string bootParameters(bool ext4Image)
     parameters.append(
         "\nUML_BOOT_UPPER=ext4\n"
         "UML_BOOT_UPPER_DEVICE=/dev/ubdb\n"
+        /* Berkut: the application keeps the overlay disk, so the guest's
+         * writes survive a relaunch; /init formats only a blank disk. */
+        "UML_BOOT_UPPER_KEEP=1\n"
         "UML_BOOT_ENTRY=/sbin/init\n");
     return parameters;
 }
diff --git a/tools/rootfs/boot-ramdisk/init b/tools/rootfs/boot-ramdisk/init
index 5f54778..81c59e4 100755
--- a/tools/rootfs/boot-ramdisk/init
+++ b/tools/rootfs/boot-ramdisk/init
@@ -21,6 +21,7 @@ root=/dev/ubda
 root_type=erofs
 upper=tmpfs
 upper_device=
+upper_keep=0
 grow=0
 entry=/sbin/init
 
@@ -39,6 +40,7 @@ read_parameters()
 		UML_BOOT_ROOT_TYPE) root_type=$value ;;
 		UML_BOOT_UPPER) upper=$value ;;
 		UML_BOOT_UPPER_DEVICE) upper_device=$value ;;
+		UML_BOOT_UPPER_KEEP) upper_keep=$value ;;
 		UML_BOOT_GROW) grow=$value ;;
 		UML_BOOT_ENTRY) entry=$value ;;
 		*) fail "unknown /boot.env parameter: ${line%%=*}" ;;
@@ -52,6 +54,10 @@ read_parameters()
 	*) fail "UML_BOOT_UPPER_DEVICE needs UML_BOOT_UPPER=ext4" ;;
 	esac
 	case "$grow" in 0|1) ;; *) fail "UML_BOOT_GROW must be 0 or 1" ;; esac
+	case "$upper_keep" in 0|1) ;; *) fail "UML_BOOT_UPPER_KEEP must be 0 or 1" ;; esac
+	if [ "$upper_keep" = 1 ] && [ "$upper" != ext4 ]; then
+		fail "UML_BOOT_UPPER_KEEP needs UML_BOOT_UPPER=ext4"
+	fi
 	case "$entry" in /*) ;; *) fail "UML_BOOT_ENTRY must be absolute: $entry" ;; esac
 	if [ "$grow" = 1 ] && [ "$upper" != none ]; then
 		fail "UML_BOOT_GROW needs UML_BOOT_UPPER=none"
@@ -167,6 +173,35 @@ mount_direct_root()
 		fail "cannot mount $root"
 }
 
+format_upper()
+{
+	mkfs.ext4 -F -q -m 0 \
+		-E nodiscard,lazy_itable_init=1,lazy_journal_init=1 \
+		"$1" || fail "cannot format $1"
+}
+
+# With UML_BOOT_UPPER_KEEP=1 the writable layer outlives the run: a device
+# that already holds ext4 is checked, repaired and grown to the device's size
+# instead of formatted. It fails, and the caller formats, only for a blank
+# device or one e2fsck cannot repair.
+keep_upper()
+{
+	local status
+	e2fsck -p "$1"
+	status=$?
+	if [ "$status" -ge 8 ]; then
+		echo "UML_BOOT_UPPER_NEW:$1"
+		return 1
+	fi
+	if [ "$status" -ge 4 ]; then
+		echo "UML_BOOT_UPPER_REPAIR:$1"
+		e2fsck -fy "$1"
+		[ "$?" -lt 4 ] || return 1
+	fi
+	resize2fs "$1" || echo "UML_BOOT_UPPER_WARN:resize2fs-failed:$1"
+	return 0
+}
+
 # The image read-only beneath a writable layer that ends with the run. Both
 # layers stay visible in the new root, at /.uml-lower and /.uml-state, so a
 # guest can check what it runs on and keep bulky state beside the overlay.
@@ -185,11 +220,21 @@ mount_overlay_root()
 		;;
 	ext4)
 		wait_for_device "$upper_device"
-		mkfs.ext4 -F -q -m 0 \
-			-E nodiscard,lazy_itable_init=1,lazy_journal_init=1 \
-			"$upper_device" || fail "cannot format $upper_device"
+		if [ "$upper_keep" = 1 ] && keep_upper "$upper_device"; then
+			echo "UML_BOOT_UPPER_KEPT:$upper_device"
+		else
+			format_upper "$upper_device"
+		fi
 		mount -t ext4 -o noatime,nosuid,nodev "$upper_device" /state || \
 			fail "cannot mount $upper_device"
+		# A guest asks for a fresh layer by leaving this file in it.
+		if [ "$upper_keep" = 1 ] && [ -e /state/.uml-reset ]; then
+			echo "UML_BOOT_UPPER_RESET:$upper_device"
+			umount /state || fail "cannot unmount $upper_device"
+			format_upper "$upper_device"
+			mount -t ext4 -o noatime,nosuid,nodev "$upper_device" /state || \
+				fail "cannot mount $upper_device"
+		fi
 		;;
 	esac
 	mkdir -p /state/upper /state/work || \
@@ -199,7 +244,7 @@ mount_overlay_root()
 		overlay /newroot || fail "cannot mount the overlay"
 	[ "$upper" = ext4 ] || return 0
 	for name in docker containerd; do
-		mkdir -m 0711 "/state/$name" && \
+		mkdir -p -m 0711 "/state/$name" && \
 			mkdir -p "/newroot/var/lib/$name" && \
 			mount -o bind "/state/$name" "/newroot/var/lib/$name" || \
 			fail "cannot bind the $name state"
